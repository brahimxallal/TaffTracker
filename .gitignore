# ============================================================
#  Vision Gimbal Tracker — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test, coverage & tooling caches ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Editors & OS ---
.idea/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# --- AI-assistant & local tooling state (never commit) ---
.claude/
.codex_tools/
.gsd/
plans/
docs/superpowers/
/.codex_runtime_screen*.png

# --- Local scratch space (may hold third-party or decompiled material) ---
standalone_experiments/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
firmware/**/*.env
!firmware/**/*.env.example
*.jks
*.keystore

# --- Large, machine-specific ML artifacts ---
# Weights are also dropped in the working directory by the ultralytics auto-download,
# so these are ignored repo-wide, not only under models/ and engines/.
*.pt
*.engine
*.onnx
models/*.cache
models/**/*.cache

# --- Calibration data (generated per camera) ---
calibration_data/*.npz
calibration_data/int8_calib.yaml
calibration_data/int8_calib/
calibration_data/servo_limits.json
calibration_data/*.png
checkerboard_*.png

# --- Videos & logs (large, run-specific) ---
videos/**
!videos/.gitkeep
logs/**
!logs/.gitkeep
*.log

# --- Firmware build output ---
firmware/esp32s3_gimbal/.pio/
firmware/esp32s3_gimbal/.vscode/
firmware/esp32s3_gimbal/sdkconfig
firmware/esp32s3_gimbal/managed_components/
firmware/esp32s3_gimbal/compile_commands.json

# --- Android local/build state ---
android/**/.gradle/
android/**/.kotlin/
android/**/build/
android/**/*.apk
android/**/*.aab
local.properties

# --- Backups & temporary files ---
*.bak
*.tmp
*.tar
