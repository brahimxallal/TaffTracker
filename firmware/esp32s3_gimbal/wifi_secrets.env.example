# Copy this file to wifi_secrets.env and fill in your credentials.
# wifi_secrets.env is gitignored and will NOT be committed.
TAFFF_WIFI_SSID=YourSSID
TAFFF_WIFI_PASS=YourPassword

# Optional: fixed station IP for UDP fallback.
# Prefer a router DHCP reservation when possible. If using firmware static IP,
# pick an address outside the router DHCP pool or reserve this exact address.
TAFFF_WIFI_STATIC_IP=192.168.1.12
TAFFF_WIFI_GATEWAY=192.168.1.1
TAFFF_WIFI_NETMASK=255.255.255.0
TAFFF_WIFI_DNS=192.168.1.1
